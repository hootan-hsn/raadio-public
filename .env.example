# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# .env is ignored by Git. Never commit it.
# Keep comments on their own lines (Docker doesn't strip comments after values).

# ---- Telegram (https://my.telegram.org -> API development tools) -----
TG_API_ID=12345678
TG_API_HASH=replace_me
# Session file: data/<TG_SESSION_NAME>.session
TG_SESSION_NAME=radio_user
TG_CHANNEL_ID=-1000000000000

# ---- Icecast ----------------------------------------------------------
# Make each one with: openssl rand -hex 16
# The controller uses the source password to send audio to Icecast.
ICECAST_SOURCE_PASSWORD=replace_me
# For the Icecast admin page (http://127.0.0.1:8000/admin/ on the server)
ICECAST_ADMIN_PASSWORD=replace_me
ICECAST_RELAY_PASSWORD=replace_me
ICECAST_HOSTNAME=raadio.run.place
ICECAST_ADMIN_EMAIL=admin@raadio.run.place
ICECAST_MAX_LISTENERS=500
# Where the controller finds Icecast. Docker Compose overrides this with "icecast".
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000

# ---- Streams ----------------------------------------------------------
MP3_BITRATE=128k
OPUS_ENABLED=true
# "HQ" in the player (default) and "Saver" (leave empty to turn the Saver mount off)
OPUS_BITRATE=64k
OPUS_LITE_BITRATE=32k
# "Saver" for devices that can't play Opus (empty turns it off)
MP3_LITE_BITRATE=64k
# Relay servers whose listeners count in the curator stats (see relay/README.md), e.g.
# RELAY_STATUS_URLS=https://radio.example.ir/relay-status.json
RELAY_STATUS_URLS=
# Level every song, show and recording to the same perceived loudness (EBU R128)
NORMALIZE=true
LOUDNESS_TARGET=-14
# track (default): each song is measured and set to the target, no added delay.
# stream: the old continuous leveler, which adds 3 s to everything listeners hear.
LOUDNESS_MODE=track
LOUDNESS_RANGE=11
# clean (default): every song as it was uploaded, only leveled to LOUDNESS_TARGET.
# station: the old station sound: an EQ, a soft compressor and a vinyl processor, with each
# song's bass and treble evened out (MATCH_EQ); VINYL and VINYL_NOISE only count with it.
SOUND=clean

# ---- What plays when ----------------------------------------------------
# Posts with this hashtag play about SUMMER_TIMES as often in June, July and August
SUMMER_TAG=SummerBaby
SUMMER_TIMES=3
# Songs pinned in the channel get the new-upload priority for this many days after pinning
PIN_DAYS=14

# ---- Web API (Nginx forwards /skip and /now-playing here) -------------
API_HOST=127.0.0.1
API_PORT=8080

# ---- Studio -------------------------------------------------------------
# Largest upload/recording in MB (Nginx allows up to 60)
UPLOAD_MAX_MB=50
# Other sites allowed to call the studio API (besides https://raadio.xyz and
# https://raadio.run.place), comma-separated, e.g. a relay's studio name:
# STUDIO_ORIGINS=https://studio.example.ir:8443
STUDIO_ORIGINS=

# ---- Files (relative paths are inside the repo) -----------------------
DATA_DIR=data
# DB_PATH=data/radio_analytics.db
# DOWNLOAD_DIR=data/downloads

# Skip votes: each device counts, but at most this many from one internet address
VOTES_PER_IP=3
# Studio users whose skip vote counts more (when signed in, over HTTPS)
VOTE_WEIGHTS=
# New uploads: extra airtime for FRESH_DAYS days, one every FRESH_EVERY songs,
# never the same new song again within FRESH_GAP_MIN minutes (FRESH_DAYS=0 turns it off)
FRESH_DAYS=14
FRESH_EVERY=4
FRESH_GAP_MIN=90
